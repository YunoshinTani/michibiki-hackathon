{
  "version": "2.0.0",
  // PlatformIO 拡張が用意する Core を使用し、システムの PATH に依存しない。
  // Core の保存先を変更した場合は command と windows.command を合わせて変更する。
  "options": { "cwd": "${workspaceFolder}" },
  "presentation": {
    "reveal": "always",
    "panel": "dedicated",
    "clear": true
  },
  // -e を指定せず platformio.ini の default_envs に従う。
  "tasks": [
    {
      "label": "公開: みちびき測位モニター（yahikoサーバー）",
      "type": "process",
      "command": "python",
      "args": ["${workspaceFolder}/web/slas-map/server/deploy.py"],
      "problemMatcher": [],
      "detail": "SSH で既存の michibiki サイトへ HTML・CSS・JS・CGI を反映します。"
    },
    {
      "label": "みちびき測位モニター: COMポート一覧",
      "type": "process",
      "command": "${workspaceFolder}/web/slas-map/.venv/Scripts/python.exe",
      "args": ["${workspaceFolder}/web/slas-map/send_gnss.py", "--list-ports"],
      "problemMatcher": [],
      "detail": "Windowsで認識されているシリアルポートを表示します。"
    },
    {
      "label": "みちびき測位モニター: QZ1とGPS受信機を送信",
      "type": "process",
      "command": "${workspaceFolder}/web/slas-map/.venv/Scripts/python.exe",
      "args": [
        "-u",
        "${workspaceFolder}/web/slas-map/send_gnss.py",
        "--url", "https://www2.st.nagaoka-ct.ac.jp/~ec36104x/michibiki/gnss_api.cgi?action=ingest",
        "--gps-port", "${input:comparisonGpsPort}",
        "--gps-baud", "${input:comparisonGpsBaud}"
      ],
      "problemMatcher": [],
      "detail": "QZ1（COM16、115200 baud）と比較用受信機のNMEAを読み、yahikoサーバーへ送信します。"
    },
    {
      "label": "みちびき測位モニター: QZ1とiPhoneを比較",
      "type": "process",
      "command": "${workspaceFolder}/web/slas-map/.venv/Scripts/python.exe",
      "args": [
        "-u",
        "${workspaceFolder}/web/slas-map/send_gnss.py",
        "--url", "https://www2.st.nagaoka-ct.ac.jp/~ec36104x/michibiki/gnss_api.cgi?action=ingest",
        "--iphone"
      ],
      "problemMatcher": [],
      "detail": "COM16のQZ1を送信し、今回の記録を受け付けるOwnTracks用URLを表示します。"
    },
    {
      "label": "Nbed: ビルド（既定環境）",
      "type": "process",
      "command": "${userHome}/.platformio/penv/bin/platformio",
      "windows": {
        "command": "${userHome}/.platformio/penv/Scripts/platformio.exe"
      },
      "args": ["run"],
      "problemMatcher": ["$platformio"],
      "group": { "kind": "build", "isDefault": true },
      "detail": "platformio.ini の default_envs をビルド。Ctrl+Shift+B。"
    },
    {
      "label": "Nbed: 書き込み（既定環境）",
      "type": "process",
      "command": "${userHome}/.platformio/penv/bin/platformio",
      "windows": {
        "command": "${userHome}/.platformio/penv/Scripts/platformio.exe"
      },
      "args": ["run", "--target", "upload"],
      "problemMatcher": ["$platformio"],
      "detail": "既定環境をビルドして実機へ書き込む。"
    },
    {
      "label": "Nbed: clangd用ビルド情報を更新（既定環境）",
      "type": "process",
      "command": "${userHome}/.platformio/penv/bin/platformio",
      "windows": {
        "command": "${userHome}/.platformio/penv/Scripts/platformio.exe"
      },
      "args": ["run", "--target", "compiledb"],
      "problemMatcher": ["$platformio"],
      "detail": "ファームウェアをコンパイルせず compile_commands.json を再生成する。"
    },
    {
      "label": "Nbed: クリーン（既定環境）",
      "type": "process",
      "command": "${userHome}/.platformio/penv/bin/platformio",
      "windows": {
        "command": "${userHome}/.platformio/penv/Scripts/platformio.exe"
      },
      "args": ["run", "--target", "clean"],
      "problemMatcher": ["$platformio"],
      "detail": "PlatformIO の通常クリーン。共有ビルドキャッシュは残す。"
    },
    {
      "label": "Nbed: 生成物とキャッシュを全削除",
      "type": "process",
      "command": "${userHome}/.platformio/penv/bin/python",
      "windows": {
        "command": "${userHome}/.platformio/penv/Scripts/python.exe"
      },
      "args": ["${workspaceFolder}/.vscode/clean.py"],
      "problemMatcher": [],
      "detail": "全環境の build/・.cache/・旧 .pio/build/ とルートの生成DBを削除する。"
    },
    {
      "label": "Nbed: 完全再ビルド（既定環境）",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Nbed: 生成物とキャッシュを全削除",
        "Nbed: ビルド（既定環境）"
      ],
      "group": "build",
      "problemMatcher": [],
      "detail": "全環境の生成物とキャッシュを削除した後、既定環境をビルドする。"
    }
  ],
  "inputs": [
    {
      "id": "comparisonGpsPort",
      "type": "promptString",
      "description": "比較用GPS受信機のCOMポートを入力してください（例 COM17）。"
    },
    {
      "id": "comparisonGpsBaud",
      "type": "promptString",
      "description": "比較用GPS受信機の通信速度（baud）を入力してください。",
      "default": "9600"
    }
  ]
}
