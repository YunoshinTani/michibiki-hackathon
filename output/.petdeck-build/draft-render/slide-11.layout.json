{"id":"sh/72t03qp0","kind":"textbox","name":"Text 6","position":{"left":89.28,"top":277.44,"width":144,"height":26.88},"text":"1週間以内","style":{"fontSize":14.67,"typeface":"Noto Sans CJK JP","color":"#333333","bold":true,"alignment":"left"},"geometry":"rect"},
