{"id":"sh/ih8ju9sn","kind":"textbox","name":"Text 7","position":{"left":660.48,"top":194.88,"width":528.96,"height":113.28},"text":"家の中や近所を探す、呼びかける。\nペットカメラ、迷子札、スマートタグを使う。\n体調の変化は日々の観察で気づく。","style":{"fontSize":21,"typeface":"Noto Sans CJK JP","color":"#333333","alignment":"left"},"geometry":"rect"},
{"id":"sh/kbm987y5","kind":"shape","name":"Shape 8","position":{"left":72,"top":357.12,"width":1134.72,"height":216},"style":{"fontSize":24,"typeface":"Noto Sans CJK JP","color":"#000000","alignment":"left"},"geometry":"roundRect","fillColor":"#F5F7FA","lineColor":"#D9DEE7","lineWidth":1.33},
